# Copy to .env. Never commit .env.
VANMITRA_ENV=development
VANMITRA_CORS_ORIGINS=["*"]

# Same variable names as the host app (vanMitraAI/vanmitra_backend/.env).
VANMITRA_JWT_SECRET=dev-only-change-me
VANMITRA_ACCESS_TOKEN_MINUTES=30
# VANMITRA_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
# VANMITRA_MONGODB_DB=vanmitra

# "memory" keeps nothing between restarts (fine for development and tests).
# "mongo" uses the database above. Indexes and seed data are created by a person (see scripts/).
VANMITRA_LIVELIHOOD_STORE=memory

# Development only: accept the built-in demo users (mint a token with scripts/dev_token.py), and
# serve the unauthenticated SAMPLE report route. Both are refused when VANMITRA_ENV=production.
VANMITRA_LIVELIHOOD_DEV_USERS=true
VANMITRA_LIVELIHOOD_DEMO_ENDPOINTS=true

# Search radius (metres). Default 5 km as requested; the cap protects the server.
VANMITRA_LIVELIHOOD_DEFAULT_RADIUS_M=5000
VANMITRA_LIVELIHOOD_MAX_RADIUS_M=10000

# The AI step of the Ask box. OFF by default. Needs an Anthropic API key, which lives ONLY here
# (never in the app, never committed). The model is the owner's choice; see docs/OPEN_QUESTIONS.md Q10.
# Only a person's report facts are sent (never the name or the plot's coordinates), and only when
# the person has allowed it in the app. Run scripts/eval_ask_ai.py before switching this on.
VANMITRA_LIVELIHOOD_AI_ENABLED=false
# VANMITRA_ANTHROPIC_API_KEY=
# VANMITRA_LIVELIHOOD_AI_MODEL=claude-opus-5-5
# VANMITRA_LIVELIHOOD_AI_EFFORT=low
# VANMITRA_LIVELIHOOD_AI_DAILY_LIMIT=20
